<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<h1>Lista de Fichas Técnicas</h1>

<a href="/fichas/cadastrar">
  Cadastrar Ficha técnica
</a>

<hr>

<ul>

  {{#each fichas}}

    <li>
    
      <a href='/fichas/{{this.id}}'>{{this.nome}} </a>

      <a href="/fichas/{{this.id}}/editar"><i class="fa-solid fa-pen-to-square"></i></a>
      
      <form action="/fichas/{{this.id}}?_method=DELETE" method="POST" style="display: inline;">
        <button type="submit"><i class="fa-solid fa-trash-can"></i></button>
      </form>
    </li>

  {{/each}}

</ul>