<h1>Cadastrar Ficha Técnica</h1>

<form action="/fichas" method="POST">

  <div>
    <label>Nome do Filme:</label>
    <input type="text" name="nome">
  </div>

  <br>

  <div>
    <label>Direção:</label>
    <input type="text" name="direcao">
  </div>

  <br>

  <div>
    <label>Artistas:</label>
    <input type="text" name="artistas">
  </div>

  <br>

  <div>
    <label>Sumário:</label>
    <input type="text" name="sumario">
  </div>

  <br>
  <button type="submit">
    Cadastrar
  </button>

</form>