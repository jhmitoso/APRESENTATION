<h1>Editar Filme</h1>

<form action="/artistas/{{artista.id}}?_method=PUT" method="POST">

  <div>
    <label>Nome do Artista:</label>
    <input type="text" name="nome" value="{{artista.nome}}">
  </div>

  <br>

  <div>
    <label>Idade:</label>
    <input type="number" name="ano" value="{{artista.ano}}">
  </div>

  <br>

  <button type="submit">
    Editar
  </button>
</form>